# Server: localhost by default in this example; choose HOST explicitly for LAN access.
# First independent install/update/backup: docs/INSTALL_RECOVERY.md; macOS: docs/MACOS.md; Windows: docs/WINDOWS.md.
# Linux uses /proc; macOS and Windows require their bundled Node-API components.
# Windows uses absolute drive paths and semicolon-separated PI_PROJECT_ROOTS, e.g. C:\Projects;D:\Work.
# PI_NODE_HEADERS is only a build-shell override for scripts/build-darwin-fd.cjs, not a runtime .env setting.
# Set absolute instance paths below; this loader does not expand ~, $HOME or ${variables}.
# Nonempty inherited process variables take precedence over this file.
PORT=3001
HOST=127.0.0.1

# Optional workspace-wide access validation: APIs, WebSocket and private media.
# Empty keeps the saved Web setting; without a saved setting the default is open.
# A nonempty PI_WEB_TOKEN forces validation and locks the Web toggle/token editor.
PI_WEB_TOKEN=
# For an HTTPS reverse proxy, preserve Host and explicitly enable Secure cookies.
# X-Forwarded-* is not trusted automatically. Leave false for direct private-network HTTP.
# PI_WEB_SECURE_COOKIE=true
# Default roots are the current working directory and the system user's home.
# Use a colon-separated list of absolute paths; project roots are not a tool sandbox.
PI_PROJECT_ROOTS=
PI_ALLOWED_ORIGINS=
PI_WEB_IDLE_MS=900000
# PI_WEB_APPROVE_PROJECTS=false
# Leave unset to use saved Pi trust decisions and defaultProjectTrust.
# Settings > Pi configuration can save per-project trust; changes affect new runtimes.
# An explicit true/false above overrides the saved trust decision for Web workers.
# PI_TELEMETRY=0
# PI_OFFLINE=1
# Telemetry is separate from the Web worker's disabled startup version check.
# PI_WEB_CLI=/absolute/path/to/pi/dist/cli.js
# PI_CODING_AGENT_DIR=/absolute/path/to/this-instance/agent
# PI_WEB_DEFERRED_FILE=/absolute/path/to/this-instance/deferred.json

# Set explicitly for side-by-side instances if the shell inherited another instance's URL.
# When absent, server.js uses its actual bound port.
# PI_WORKSPACE_BASE_URL=http://127.0.0.1:3001
# Independent CLI Package only: set its explicit base URL and access token together.
# The server supplies a separate scoped process credential to its managed planners.
# PI_WORKSPACE_ACCESS_TOKEN=

# Settings > Models stores an independent planner preference. Empty means Pi's default model.
PI_MEDIA_PLANNER_MODEL=

# Media configuration stays outside shareable source. Defaults to <Pi agent dir>/media-lab.
# PI_MEDIA_CONFIG_DIR=/absolute/path/to/this-instance/media-lab
# Independent data root: histories, prompts.json and public/{images,videos,audio}.
# PI_MEDIA_DATA_DIR=/absolute/path/to/this-instance/media-data
# Read-only clean preview: ignores local media profiles and this .env file.
# Set PI_MEDIA_PROFILE=clean in the launching environment, not here.

# Optional GPU bridge and existing local worker assets. No bridge path is bundled.
GPU_EXEC=
# ZJY_ROOT=/absolute/path/to/your/worker-assets
# TTS providers/voices/adapter settings belong in local media-lab/tts-providers.json.
# BREEZE_TTS_HEALTH_URL=http://127.0.0.1:8240/health
# BREEZE_TTS_SPEECH_URL=http://127.0.0.1:8240/v1/audio/speech
# BREEZE_TTS_START_SCRIPT=/absolute/remote/path/to/start.sh
# QWEN3_TTS_REMOTE_ROOT=/absolute/remote/path/to/qwen3-tts
# QWEN3_TTS_HEALTH_URL=http://127.0.0.1:8190/health
# QWEN3_TTS_SPEECH_URL=http://127.0.0.1:8190/v1/audio/speech

# MiniMax H3 also accepts a Key saved via Settings > Provider in Pi's credential store.
MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_API_KEY=
# MINIMAX_VIDEO_API_KEY=
# Legacy MIMIMAX_API_KEY spelling is accepted by TTS only; use MINIMAX_API_KEY.

# Flux 2 Dev requires current ComfyUI nodes and these weights.
FLUX2_COMFY_BASE_URL=
FLUX2_DIFFUSION_MODEL=flux2_dev_fp8mixed.safetensors
FLUX2_TEXT_ENCODER=mistral_3_small_flux2_fp8.safetensors
FLUX2_VAE=flux2-vae.safetensors

# Managed media Providers save their Key through the Web UI and Pi's credential API;
# no environment variable is required. Legacy http-json definitions may still use tokenEnv.
# MY_MEDIA_API_KEY=
# Other Pi provider environment variables may be set here, or use Settings > Provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HOME is inherited from the service user; do not override it here.
