# Pivane instance configuration. Use absolute paths; ~ and variable expansion are not supported.
# Inherited process settings take precedence over this file, including legacy PI_ aliases.
# See docs/INSTALL_RECOVERY.md and docs/development/NAMING.md.
PORT=3001
HOST=127.0.0.1

# Workspace access. Empty keeps the saved setting; a new instance is open by default.
# A nonempty token forces validation. Configure Secure cookies for an HTTPS reverse proxy.
PIVANE_WEB_TOKEN=
# PIVANE_WEB_SECURE_COOKIE=true
PIVANE_ALLOWED_ORIGINS=

# Empty allows OS-accessible roots: / on POSIX, existing drive roots on Windows.
# Explicit roots use ':' on POSIX and ';' on Windows. This is not a tool sandbox.
PIVANE_PROJECT_ROOTS=
PIVANE_WEB_IDLE_MS=900000
# PIVANE_WEB_APPROVE_PROJECTS=false
# Without an override, workers follow Pi's saved project trust and default policy.
# PIVANE_WEB_CLI=/absolute/path/to/pi/dist/cli.js

# Pi-native identity and process options retain their upstream names.
# Resolve an existing CLI identity with: node scripts/pi-agent-dir.cjs
# PI_CODING_AGENT_DIR=/absolute/path/to/existing/pi/agent
# PI_TELEMETRY=0
# PI_OFFLINE=1

# Instance data stays separate from shareable source. Use distinct paths for parallel instances.
# PIVANE_WEB_DEFERRED_FILE=/absolute/path/to/instance/pivane-deferred-messages.json
# PIVANE_MEDIA_CONFIG_DIR=/absolute/path/to/instance/media-lab
# PIVANE_MEDIA_DATA_DIR=/absolute/path/to/instance/media-data
# Set PIVANE_MEDIA_PROFILE=clean in the launching environment to skip this .env and local media profiles.

# Explicit URL for an instance or independent media CLI Package; otherwise the server uses its bound port.
# PIVANE_WORKSPACE_BASE_URL=http://127.0.0.1:3001
# PIVANE_WORKSPACE_ACCESS_TOKEN=
# The managed server supplies a separate scoped planning credential to its own workers.
PIVANE_MEDIA_PLANNER_MODEL=

# Optional legacy GPU bridge and worker assets. No bridge or executable service is bundled.
GPU_EXEC=
# ZJY_ROOT=/absolute/path/to/worker-assets
# TTS adapters are configured in the external media-lab/tts-providers.json; see docs/tts-providers/README.md.
# BREEZE_TTS_HEALTH_URL=http://127.0.0.1:8240/health
# BREEZE_TTS_SPEECH_URL=http://127.0.0.1:8240/v1/audio/speech
# BREEZE_TTS_START_SCRIPT=/absolute/remote/path/to/start.sh
# QWEN3_TTS_REMOTE_ROOT=/absolute/remote/path/to/qwen3-tts
# QWEN3_TTS_HEALTH_URL=http://127.0.0.1:8190/health
# QWEN3_TTS_SPEECH_URL=http://127.0.0.1:8190/v1/audio/speech

# Provider-owned environment names remain unchanged. Prefer the model/provider settings UI for keys.
MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_API_KEY=
# MINIMAX_VIDEO_API_KEY=
FLUX2_COMFY_BASE_URL=
FLUX2_DIFFUSION_MODEL=flux2_dev_fp8mixed.safetensors
FLUX2_TEXT_ENCODER=mistral_3_small_flux2_fp8.safetensors
FLUX2_VAE=flux2-vae.safetensors
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HOME belongs to the service user; do not override it here.
