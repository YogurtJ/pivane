{
  "name": "pivane",
  "version": "1.4.0",
  "description": "Pivane: a personal AI workspace powered by Pi Coding Agent with a media laboratory",
  "main": "server.js",
  "private": true,
  "pivaneCompatibility": {
    "piVersion": "0.99.1",
    "mcp": "native"
  },
  "scripts": {
    "postinstall": "node scripts/install-bundled-capabilities.cjs",
    "start": "node scripts/start-managed.cjs",
    "start:direct": "node server.js --direct",
    "test": "node scripts/run-tests.cjs",
    "check": "node scripts/check-syntax.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "pack:trial": "node scripts/package-trial.cjs",
    "pack:release": "node scripts/package-trial.cjs --release",
    "access:reset": "node scripts/access-reset.cjs"
  },
  "overrides": {
    "undici": "8.11.2",
    "brace-expansion": "5.0.12",
    "@earendil-works/pi-tui": "0.99.1",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/chord": "0.99.1",
    "@earendil-works/pi-protocol": "0.99.1",
    "@earendil-works/pi-telemetry": "0.99.1",
    "@earendil-works/pi-server": {
      "@earendil-works/chord": "0.99.1",
      "@earendil-works/pi-agent-core": "0.99.1",
      "@earendil-works/pi-protocol": "0.99.1",
      "@earendil-works/pi-ai": "0.99.1",
      "@earendil-works/pi-telemetry": "0.99.1"
    }
  },
  "keywords": [],
  "author": "Pivane contributors",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-server": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@highlightjs/cdn-assets": "11.11.1",
    "acorn": "8.18.0",
    "better-sqlite3": "13.0.3",
    "cors": "^2.8.6",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "https-proxy-agent": "7.0.6",
    "jiti": "2.7.0",
    "marked": "18.0.11",
    "node-fetch": "^2.7.0",
    "strip-ansi": "7.2.0",
    "typebox": "1.3.27",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  }
}
