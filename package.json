{
  "name": "pivane",
  "version": "1.0.0-rc.4",
  "description": "Pivane: a personal AI workspace powered by Pi Coding Agent with a media laboratory",
  "main": "server.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/install-default-capabilities.cjs",
    "start": "node scripts/start-managed.cjs",
    "start:direct": "node server.js --direct",
    "test": "node scripts/run-tests.cjs",
    "check": "node scripts/check-syntax.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "pack:trial": "node scripts/package-trial.cjs",
    "pack:release": "node scripts/package-trial.cjs --release",
    "access:reset": "node scripts/access-reset.cjs"
  },
  "overrides": {
    "@earendil-works/pi-server": {
      "@earendil-works/chord": "0.86.1",
      "@earendil-works/pi-agent-core": "0.86.1",
      "@earendil-works/pi-protocol": "0.86.1",
      "@earendil-works/pi-ai": "0.86.1",
      "@earendil-works/pi-telemetry": "0.86.1"
    }
  },
  "keywords": [],
  "author": "Pivane contributors",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-server": "0.86.1",
    "@highlightjs/cdn-assets": "11.11.1",
    "cors": "^2.8.6",
    "dompurify": "3.4.14",
    "express": "^5.2.1",
    "https-proxy-agent": "7.0.6",
    "marked": "18.0.11",
    "node-fetch": "^2.7.0",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  }
}
